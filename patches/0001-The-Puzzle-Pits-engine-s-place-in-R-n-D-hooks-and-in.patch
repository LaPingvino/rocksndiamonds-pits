 }
 
 void CopyNativeLevel_Native_to_RND(struct LevelInfo *level)
@@ -8647,10 +8885,25 @@ void CopyNativeLevel_Native_to_RND(struct LevelInfo *level)
     CopyNativeLevel_SP_to_RND(level);
   else if (level->game_engine_type == GAME_ENGINE_TYPE_MM)
     CopyNativeLevel_MM_to_RND(level);
+  else if (level->game_engine_type == GAME_ENGINE_TYPE_PITS)
+    CopyNativeLevel_PITS_to_RND(level);
 }
 
 void SaveNativeLevel(struct LevelInfo *level)
 {
+  // a Puzzle Pits level: back into its own file
+  if (level->game_engine_type == GAME_ENGINE_TYPE_PITS)
+  {
+    CopyNativeLevel_RND_to_PITS(level);
+
+    if (SaveNativeLevel_PITS(level->file_info.filename))
+      Request("Native level file saved!", REQ_CONFIRM);
+    else
+      Request("Failed to save native level file!", REQ_CONFIRM);
+
+    return;
+  }
+
   // saving native level files only supported for some game engines
   if (level->game_engine_type != GAME_ENGINE_TYPE_BD &&
       level->game_engine_type != GAME_ENGINE_TYPE_SP)
@@ -8725,6 +8978,11 @@ static void LoadLevelFromFileInfo(struct LevelInfo *level,
       level->game_engine_type = GAME_ENGINE_TYPE_MM;
       break;
 
+    case LEVEL_FILE_TYPE_PITS:
+      LoadLevelFromFileInfo_PITS(level, level_file_info, level_info_only);
+      level->game_engine_type = GAME_ENGINE_TYPE_PITS;
+      break;
+
     case LEVEL_FILE_TYPE_DC:
       LoadLevelFromFileInfo_DC(level, level_file_info, level_info_only);
       break;
