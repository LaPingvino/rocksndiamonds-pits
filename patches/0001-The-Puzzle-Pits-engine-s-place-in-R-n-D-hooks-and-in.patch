 {
   if (level->game_engine_type == GAME_ENGINE_TYPE_BD)
@@ -8635,6 +8871,8 @@ void CopyNativeLevel_RND_to_Native(struct LevelInfo *level)
     CopyNativeLevel_RND_to_SP(level);
   else if (level->game_engine_type == GAME_ENGINE_TYPE_MM)
