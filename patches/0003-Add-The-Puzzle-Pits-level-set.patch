+# The Puzzle Pits' own letters (made by tools/pitsfont.mjs from PLASMA1.FNT)
+
+# the scripts' text: engraved, on the game's grey stone
+font.envelope_1:                        pits_font_stone.png
+font.envelope_1.x:                      0
+font.envelope_1.y:                      0
+font.envelope_1.width:                  16
+font.envelope_1.height:                 18
+font.envelope_1.frames:                 95
